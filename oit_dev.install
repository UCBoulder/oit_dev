<?php

/**
 * @file
 * Initiate dev site.
 */

/**
 * Implements hook_install().
 */
function oit_dev_install() :void {
  $clean_table = [
    0 => [
      'table' => 'user__field_user_name',
      'field' => 'field_user_name_value',
      'value' => 'oit dev',
    ],
    1 => [
      'table' => 'user__field_service_meow_dds_pod_group',
      'field' => 'field_service_meow_dds_pod_group_value',
      'value' => '1337',
    ],
    2 => [
      'table' => 'user__field_service_meow_department2id',
      'field' => 'field_service_meow_department2id_value',
      'value' => '1337',
    ],
    3 => [
      'table' => 'user__field_service_meow_department_id',
      'field' => 'field_service_meow_department_id_value',
      'value' => '1337',
    ],
    4 => [
      'table' => 'user__field_service_meow_sys_id',
      'field' => 'field_service_meow_sys_id_value',
      'value' => '1337',
    ],
  ];

  $schema = \Drupal::database()->schema();
  foreach ($clean_table as $item) {
    if (!$schema->tableExists($item['table'])) {
      continue;
    }
    $query = \Drupal::database()->update($item['table'])
      ->fields([$item['field'] => $item['value']])
      ->condition('entity_id', 26, '<>');
    $query->execute();
  }

  $user_list = [
    'theRealSummer',
    'therealanyaffiliate',
    'therealassistantdean',
    'therealassistantvc',
    'therealassociatechairdirector',
    'therealassociatedean',
    'therealassociatevc',
    'therealbeth',
    'therealbirdperson',
    'therealbutterrobot',
    'therealchairdirector',
    'therealcusystem',
    'therealdateam',
    'therealdean',
    'therealemployee',
    'therealfaculty',
    'therealjerry',
    'therealmeeseeks',
    'therealmorty',
    'therealprofessional',
    'therealprovostchancellor',
    'therealrick',
    'therealscaryterry',
    'therealspacebeth',
    'therealstaff',
    'therealstudentreports',
    'therealvc',
  ];

  $account = \Drupal::entityTypeManager()->getStorage('user')->load(26);

  $dept = $account->get('field_user_department')->getValue()[0]['value'] ?? NULL;
  $sys_id = $account->get('field_service_meow_sys_id')->getValue()[0]['value'] ?? NULL;
  $has_pod_group = $account->hasField('field_service_meow_dds_pod_group');
  $pod_group = $has_pod_group ? ($account->get('field_service_meow_dds_pod_group')->getValue()[0]['value'] ?? NULL) : NULL;
  $has_dept_id = $account->hasField('field_service_meow_department_id');
  $dept_id = $has_dept_id ? ($account->get('field_service_meow_department_id')->getValue()[0]['value'] ?? NULL) : NULL;
  foreach ($user_list as $user) {
    $this_user = user_load_by_name($user);
    $this_user->set('field_user_name', $user);
    $this_user->set('field_user_department', $dept);
    $this_user->set('field_service_meow_sys_id', $sys_id);
    if ($has_dept_id) {
      $this_user->set('field_service_meow_department_id', $dept_id);
    }
    if ($has_pod_group) {
      $this_user->set('field_service_meow_dds_pod_group', $pod_group);
    }
    $this_user->save();
  }

  // Stamp every user with a servicenow lookup_last so non-prod environments
  // skip the ServiceNow login lookup.
  $database = \Drupal::database();
  $database->delete('users_data')
    ->condition('module', 'servicenow')
    ->condition('name', 'lookup_last')
    ->execute();
  $uids = $database->select('users', 'u')
    ->fields('u', ['uid'])
    ->condition('uid', 0, '>')
    ->orderBy('uid')
    ->execute()
    ->fetchCol();
  $now = \Drupal::time()->getRequestTime();
  foreach (array_chunk($uids, 1000) as $chunk) {
    $insert = $database->insert('users_data')
      ->fields(['module', 'name', 'uid', 'value', 'serialized']);
    foreach ($chunk as $uid) {
      // Order matches fields(): module, name, uid, value, serialized.
      $insert->values(['servicenow', 'lookup_last', $uid, $now, 0]);
    }
    $insert->execute();
  }

  // Pull in archived news to add to add to robots.txt.
  \Drupal::service('oit_dev.robots');
}

/**
 * Implements hook_uninstall().
 */
function oit_dev_uninstall() :void {
  unlink("../add-to-robots.txt");
}
